{
  "$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
  "files": {
    "includes": [
      "**/*.js",
      "**/*.json",
      "**/*.jsonc",
      "!dist",
      "!target",
      "!vendor",
      "!node_modules",
      "!.obsidian",
      "!content/.obsidian",
      "!.omx",
      "!.mudcode",
      "!.opencode",
      "!.playwright",
      "!static/assets/**/*.min.js",
      "!static/assets/vendor",
      "!static/news/data",
      "!content/generated",
      "!.playwright-cli"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
