{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "files": {
    "includes": [
      "src/**/*.mjs",
      "functions/**/*.js",
      "scripts/**/*.mjs",
      "tests/**/*.mjs",
      "playwright.config.mjs",
      "!dist",
      "!target",
      "!node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
